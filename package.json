{
  "name": "tldraw-m9810223",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for editing tldraw .tldr files",
  "type": "module",
  "bin": {
    "tldraw-m9810223": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "[ -d dist ] || npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tldraw/tlschema": "^3.0.0",
    "@tldraw/utils": "^3.0.0",
    "nanoid": "^5.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
